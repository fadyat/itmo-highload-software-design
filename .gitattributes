# Basic .gitattributes for the term3 module
# - Normalize line endings for source files to LF in the repository
# - Mark common binary files so Git treats them as binary (no CRLF conversion / no merge)
# - Provide some export-ignore rules for repository metadata/docs in release archives

# Default: detect text files and normalize to LF on checkin
* text=auto

# Force LF for common source types (helps on Windows)
*.go   text eol=lf
*.sh   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.xml  text eol=lf

# Make sure Makefiles keep LF
Makefile text eol=lf

# Treat common binary types as binary (don't attempt CRLF conversion or diffs)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
*.tar  binary
*.tar.gz binary
*.tgz  binary
*.gz   binary
*.7z   binary
*.pdf  binary
*.exe  binary
*.dll  binary
*.so   binary

# Help Git choose sane diffs for Go files
*.go diff=go

# Prevent some folders/files from being included in generated archives (e.g. `git archive`)
# (useful to avoid shipping CI config, docs, or contribution templates if not desired)
.github/** export-ignore
docs/** export-ignore
*.md export-ignore
CONTRIBUTING.md export-ignore
CODE_OF_CONDUCT.md export-ignore
*.yml export-ignore

# Ensure that certain generated files are assumed binary or not merged
*.pb.go binary
*_generated.go binary

